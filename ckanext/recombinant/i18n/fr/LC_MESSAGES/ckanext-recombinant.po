msgstr "Commandes clavier"

#: ckanext/recombinant/templates/snippets/recombinant_datatable.html:64
msgid ""
"Hold <pre>SHIFT</pre> key while clicking on sort controls for multi-"
"column sorting"
msgstr ""
"Maintenez la touche <pre>SHIFT</pre> enfoncée tout en cliquant sur les "
"commandes de tri pour trier en plusieurs colonnes."

#: ckanext/recombinant/templates/snippets/recombinant_datatable.html:65
msgid ""
"Press <pre>ALT + K</pre> keys to enter KeyTable mode, allowing you to "
"navigate the table with arrow keys"
msgstr ""
"Appuyez sur les touches <pre>ALT + K</pre> pour entrer en mode de tableau"
" de clés, ce qui vous permet de naviguer dans le tableau avec des flèches"

#: ckanext/recombinant/templates/snippets/recombinant_datatable.html:67
msgid "Press <pre>SPACE</pre> key to select a row"
msgstr "Appuyez sur la touche <pre>SPACE</pre> pour sélectionner une ligne."

#: ckanext/recombinant/templates/snippets/recombinant_datatable.html:68
msgid "Press <pre>E</pre> key to expand a row (Compact Table mode only)"
msgstr ""
"Appuyez sur la touche <pre>E</pre> pour agrandir une rangée (mode de "
"tableau réduit seulement)."

#: ckanext/recombinant/templates/snippets/recombinant_datatable.html:69
msgid "Press <pre>ESC</pre> key to exit KeyTable mode"
msgstr ""
"Appuyez sur la touche <pre>ESC</pre> pour quitter le mode de tableau de "
"clés"

